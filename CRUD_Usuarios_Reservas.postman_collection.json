{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
		"name": "Segundo Entregable - CRUD Usuarios y Reservas (Spring Security & RBAC)",
		"description": "Colección completa de pruebas para el Segundo Entregable de la UCC. Incluye autenticación Basic Auth, RBAC (ADMIN y USER), registro público, validaciones, códigos HTTP esperados (200, 201, 204, 400, 401, 403, 404, 409) y consulta por relación JPA sin exponer credenciales.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Escenarios de Registro y Validaciones",
			"item": [
				{
					"name": "1. Registro válido (201 Created - Sin password/hash)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Lucas Perez\",\n  \"correo\": \"lucas.perez@example.com\",\n  \"password\": \"Segura123!\",\n  \"edad\": 26\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/registro",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "registro"]
						},
						"description": "Escenario 1: Registra un usuario válido sin autenticación. Devuelve 201 Created y comprueba que la respuesta no contiene la contraseña ni el hash."
					},
					"response": []
				},
				{
					"name": "2. Intento de registro con correo duplicado (409 Conflict)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Lucas Duplicado\",\n  \"correo\": \"lucas.perez@example.com\",\n  \"password\": \"OtraClave123\",\n  \"edad\": 30\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/registro",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "registro"]
						},
						"description": "Escenario 2: Intenta registrar el mismo correo ya existente. Devuelve 409 Conflict impidiendo la duplicación."
					},
					"response": []
				},
				{
					"name": "3. Intento de registro con datos inválidos (400 Bad Request)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"\",\n  \"correo\": \"correo-no-valido\",\n  \"password\": \"123\",\n  \"edad\": -5\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/registro",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "registro"]
						},
						"description": "Escenario 3: Contraseña corta (<6 caracteres), email inválido y edad negativa. Devuelve 400 Bad Request con detalle de validaciones."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Seguridad y Control de Acceso (RBAC)",
			"item": [
				{
					"name": "4. Acceso sin credenciales (401 Unauthorized)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/reservas",
							"host": ["{{baseUrl}}"],
							"path": ["reservas"]
						},
						"description": "Escenario 4: Intento de acceder a un endpoint protegido sin cabecera Authorization."
					},
					"response": []
				},
				{
					"name": "5. Acceso con credenciales correctas USER (200 OK)",
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "user@ucc.edu.ar",
									"type": "string"
								},
								{
									"key": "password",
									"value": "User123!",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/reservas",
							"host": ["{{baseUrl}}"],
							"path": ["reservas"]
						},
						"description": "Escenario 5: Acceso autenticado como usuario estándar USER. Devuelve 200 OK."
					},
					"response": []
				},
				{
					"name": "6. Operación restringida con rol incorrecto - USER intenta DELETE (403 Forbidden)",
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "user@ucc.edu.ar",
									"type": "string"
								},
								{
									"key": "password",
									"value": "User123!",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/usuarios/1",
							"host": ["{{baseUrl}}"],
							"path": ["usuarios", "1"]
						},
						"description": "Escenario 7: Usuario con rol USER intenta eliminar una entidad. La API deniega el acceso con 403 Forbidden."
					},
					"response": []
				},
				{
					"name": "7. Operación restringida con rol ADMIN - DELETE Reserva (204 No Content)",
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "admin@ucc.edu.ar",
									"type": "string"
								},
								{
									"key": "password",
									"value": "Admin123!",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/reservas/1",
							"host": ["{{baseUrl}}"],
							"path": ["reservas", "1"]
						},
						"description": "Escenario 6: Usuario ADMIN ejecuta la operación restringida DELETE. Devuelve 204 No Content."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Relación JPA y Seguridad de Datos",
			"item": [
				{
					"name": "8. Consulta de Reservas por Usuario (200 OK - Sin exponer password/hash)",
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "user@ucc.edu.ar",
									"type": "string"
								},
								{
									"key": "password",
									"value": "User123!",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/reservas/usuario/2",
							"host": ["{{baseUrl}}"],
							"path": ["reservas", "usuario", "2"]
						},
						"description": "Escenario 8: Consulta de reservas pertenecientes al usuario ID 2. Comprueba que el usuario anidado en la respuesta no contiene 'password' ni 'passwordHash'."
					},
					"response": []
				}
			]
		},
